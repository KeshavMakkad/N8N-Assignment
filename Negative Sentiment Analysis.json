      "parameters": {
        "jsCode": "const items = $input.all();\nconst reviews = items.filter(i => i.json.type !== 'insights');\nconst insights = items.find(i => i.json.type === 'insights').json.insights;\n\nconst line = '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━';\n\nconst reviewDetails = reviews.map(i => \n  `[${i.json.bucket}] ${i.json.brand_name} - ${i.json.product_name} (${i.json.rating} stars)\\n\"${i.json.review_title}\"\\n${i.json.review_text}`\n).join('\\n\\n');\n\nconst report = [\n  'NEGATIVE REVIEW ANALYSIS REPORT',\n  line,\n  `Generated: ${new Date().toISOString().split('T')[0]}`,\n  `Total Negative Reviews Analysed: ${reviews.length}`,\n  '',\n  line,\n  'BUCKET BREAKDOWN',\n  line,\n  `Skin Reaction:        ${reviews.filter(i => i.json.bucket === 'Skin Reaction').length} reviews`,\n  `Efficacy / Results:   ${reviews.filter(i => i.json.bucket === 'Efficacy / Results').length} reviews`,\n  `Texture/Consistency:  ${reviews.filter(i => i.json.bucket === 'Texture / Consistency').length} reviews`,\n  `Smell / Fragrance:    ${reviews.filter(i => i.json.bucket === 'Smell / Fragrance').length} reviews`,\n  `Packaging:            ${reviews.filter(i => i.json.bucket === 'Packaging').length} reviews`,\n  `Price / Value:        ${reviews.filter(i => i.json.bucket === 'Price / Value').length} reviews`,\n  `Authenticity:         ${reviews.filter(i => i.json.bucket === 'Authenticity').length} reviews`,\n  `Customer Service:     ${reviews.filter(i => i.json.bucket === 'Customer Service').length} reviews`,\n  `Other:                ${reviews.filter(i => i.json.bucket === 'Other').length} reviews`,\n  '',\n  line,\n  'AI INSIGHTS & RECOMMENDATIONS',\n  line,\n  insights,\n  '',\n  line,\n  'REVIEW DETAILS',\n  line,\n  reviewDetails\n].join('\\n');\n\nreturn [{ json: { report } }];"
      },
